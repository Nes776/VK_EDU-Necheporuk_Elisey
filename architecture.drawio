<mxfile host="app.diagrams.net" modified="2026-11-25T12:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="cdc-scd-lakehouse" name="Архитектура CDC-SCD-Lakehouse"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Архитектура обработки изменений&lt;br/&gt;CDC → SCD Type 2 → Lakehouse" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="1100" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="Вариант 1 · Историзация операционного справочника банковских счетов" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#526581;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="1100" height="30" as="geometry" /></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;Операционная БД&lt;br/&gt;&lt;font style='font-size:12px'&gt;public.accounts&lt;br/&gt;INSERT / UPDATE / DELETE&lt;br/&gt;WAL · logical replication&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1F3B63;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="230" width="220" height="145" as="geometry" /></mxCell><mxCell id="dbz" value="&lt;b&gt;Debezium&lt;/b&gt;&lt;br/&gt;Kafka Connect&lt;br/&gt;&lt;font style='font-size:12px'&gt;PostgreSQL Connector&lt;br/&gt;pgoutput · CDC events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#274E13;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="230" width="220" height="145" as="geometry" /></mxCell><mxCell id="kafka" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br/&gt;&lt;font style='font-si