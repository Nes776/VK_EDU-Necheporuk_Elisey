lor=#B85450;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#7A1F1B;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="535" width="270" height="130" as="geometry" /></mxCell><mxCell id="trino" value="&lt;b&gt;Trino&lt;/b&gt;&lt;br/&gt;SQL-движок&lt;br/&gt;&lt;font style='font-size:12px'&gt;Чтение lake.db.accounts_scd2&lt;br/&gt;Исторические аналитические запросы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#7F6000;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="535" width="270" height="130" as="geometry" /></mxCell><mxCell id="users" value="&lt;b&gt;Аналитики / бухгалтерия&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:12px'&gt;Текущее состояние&lt;br/&gt;и состояние на выбранную дату&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#333333;spacing=10;" vertex="1" parent="1"><mxGeometry x="150" y="535" width="270" height="130" as="geometry" /></mxCell><mxCell id="e1" value="WAL / logical replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="dbz"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="CDC events (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dbz" target="kafka"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Kafka topic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="kafka" target="spark"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="SCD2 rows / MERGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spark" target="iceberg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Физические файлы Parquet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="iceberg" target="minio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="SQL-результаты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2878B5;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="trino" target="users"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="REST Catalog: metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C65911;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=12;fontColor=#8A3C0A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spark" target="lakekeeper"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Регистрация / метаданные таблицы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C65911;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=12;fontColor=#8A3C0A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lakekeeper" target="iceberg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="REST Catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C65911;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=12;fontColor=#8A3C0A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="trino" target="lakekeeper"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Чтение файлов Iceberg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#777777;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;fontSize=11;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="trino" target="minio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Запись файлов через S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#777777;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;fontSize=11;fontColor=#555555;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spark" target="minio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br/&gt;&lt;font color='#2878B5'&gt;━━━▶&lt;/font&gt; Поток данных&lt;br/&gt;&lt;font color='#C65911'&gt;┄┄┄▷&lt;/font&gt; Взаимодействие с каталогом&lt;br/&gt;&lt;font color='#777777'&gt;┄┄┄▷&lt;/font&gt; Доступ к объектному хранилищу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="760" width="440" height="135" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;Примечание&lt;/b&gt;&lt;br/&gt;Apache Iceberg — табличный формат и слой метаданных, а не отдельный сервер.&lt;br/&gt;MinIO хранит физические объекты, Lakekeeper предоставляет REST Catalog,&lt;br/&gt;Trino и Spark используют каталог для доступа к таблице." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="570" y="760" width="970" height="135" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>